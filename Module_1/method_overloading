package Basic;
 
public class module_1_5 {
        	
	String name;
	int age;
 
	static String schoolName = "Greenwood High";
 
	public module_1_5() {
    	name = "Not Assigned";
    	age = 0;
	}
 
	public module_1_5(String name) {
        this.name = name;
        this.age = 18;
	}
 
	public module_1_5(String name, int age) {
        this.name = name;
        this.age = age;
	}
 
	public void displayDetails() {
        System.out.println("Name: " + name);
        System.out.println("Age: " + age);
        System.out.println("School: " + schoolName);
        System.out.println("----------------------");
	}
 
	public static void changeSchool(String newSchoolName) {
    	schoolName = newSchoolName;
	}
 
        	public static void main(String[] args) {
                    	
        module_1_5.changeSchool("Sunrise Academy");
 
        module_1_5 s1 = new module_1_5();
        module_1_5 s2 = new module_1_5("Ravi");
        module_1_5 s3 = new module_1_5("Sneha", 22);
 
        s1.displayDetails();
        s2.displayDetails();
        s3.displayDetails();
 
        	}
 }
