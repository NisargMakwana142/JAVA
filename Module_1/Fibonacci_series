Write a program to display the Fibonacci series using a loop.
Package Basic;
Public class fibonacci{
 	Public static void main(String[] args){
      	int a = 0;
      	int b = 1;
      	for(int i = 0; i <= 9 ; i++) {
           	int c = a+b;
           	System.out.println(c);
           	a=b;
           	b=c;
      	}
  	}
}
